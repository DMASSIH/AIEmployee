{
  "name": "@aie/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf dist",
    "test:rls": "psql \"$RLS_TEST_URL\" -f tests/rls-isolation.sql",
    "test:withorg": "tsx tests/withorg-smoke.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@aie/config": "workspace:*",
    "@types/node": "^22.13.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0"
  }
}
