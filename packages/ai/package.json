{
  "name": "@aie/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@aie/core": "workspace:*",
    "@aie/db": "workspace:*",
    "@aie/knowledge": "workspace:*",
    "@aie/memory": "workspace:*",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@aie/config": "workspace:*",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
