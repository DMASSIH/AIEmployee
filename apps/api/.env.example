# Copy to apps/api/.env for local development: `cp apps/api/.env.example apps/api/.env`
# Loaded automatically by `pnpm dev` / `pnpm start` via tsx/node --env-file-if-exists.
# Only the variables validated in src/config/env.ts are read by the API.

# Postgres — app connects as the non-superuser aie_app role (RLS enforced).
DATABASE_URL=postgresql://aie_app:dev@localhost:5432/aie
# Superuser/owner — used by `pnpm db:migrate` and `pnpm db:seed` only.
MIGRATION_DATABASE_URL=postgresql://postgres:dev@localhost:5432/aie

REDIS_URL=redis://localhost:6379

# Must be at least 32 characters (signs the session cookie).
COOKIE_SECRET=change-me-32-chars-minimum-secret!!

# Browser origin allowed by CORS (the Next.js web app).
WEB_ORIGIN=http://localhost:3000

# Optional (have sensible defaults in env.ts).
SESSION_TTL_SECONDS=604800
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
