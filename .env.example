# ---- Database (matches docker-compose) ----
# The APP and the tenant-isolation tests connect as the non-superuser `aie_app`
# role so Postgres Row-Level Security is enforced (superusers bypass RLS).
DATABASE_URL=postgresql://aie_app:dev@localhost:5432/aie
# Migrations and the dev seed run as the superuser/owner — only it may create
# the schema, extensions, and RLS policies the app role isn't allowed to.
MIGRATION_DATABASE_URL=postgresql://postgres:dev@localhost:5432/aie

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Object storage (MinIO locally, S3 in prod) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aie-dev

# ---- API ----
API_PORT=3001
API_HOST=0.0.0.0
COOKIE_SECRET=change-me-32-chars-minimum-secret!!
# Browser origin allowed to call the API (CORS) — validated in apps/api env.
WEB_ORIGIN=http://localhost:3000

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---- Email (Mailpit locally) ----
SMTP_HOST=localhost
SMTP_PORT=1025
